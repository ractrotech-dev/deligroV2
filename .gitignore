# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/zap-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.local/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# Legacy migration artifacts — contain live secrets + real customer PII.
# NEVER commit to this public repo (live Razorpay keys, ~1.2k passwords,
# ~10k phone numbers / ~3.5k emails). Run them locally against Supabase only.
docs/LEGACY_DB_AUDIT.md
docs/LEGACY_SEED_MAPPING.md
supabase/seed/legacy_customers.sql

# Supabase CLI's local cache — machine-specific, regenerates on its own.
supabase/.temp

# typescript
*.tsbuildinfo
next-env.d.ts

# Design reference archives and screenshots — kept locally, never committed.
# A zip in version control cannot be diffed or reviewed, and the WhatsApp export
# names contain spaces and colons that break shell scripts and CI checkout on
# Windows. Anything here that still informs current work belongs in
# docs/design-refs/ under a descriptive name.
/Bolt Food ios May 2025/
/WhatsApp Unknown */
*.zip
# Ops-script safety files: undo lists and pre-delete row backups. They are
# snapshots of live catalog data, useful locally and not something to commit.
scripts/ops/undo-dish-photos-*.json
scripts/ops/deleted-menu-items-*.json
.superpowers/

# Android shells (mobile/)
mobile/apps/*/node_modules/
mobile/apps/*/android/app/build/
mobile/apps/*/android/build/
mobile/apps/*/android/.gradle/
mobile/apps/*/android/local.properties
mobile/dist/
*.jks
*.keystore
keystore.properties

# Local database dumps — real customer data, never commit (public repo).
/backups/
